{#
	Gabarit des pages légales — maquettes Figma « MENTIONS LÉGALES » (537:2778),
	« POLITIQUE DE CONFIDENTIALITÉ » (537:2669) et « POLITIQUE DE GESTION DES
	COOKIES » (537:2579) : titre sur deux lignes, pastille de mise à jour, puis
	une carte blanche par rubrique (<section class="bz-legal__carte">).
#}
{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/legal.css') }}">
{% endblock %}

{% block page_class %}bz-page--legal{% endblock %}

{% block page_fond %}
	<div class="bz-fond" aria-hidden="true">
		<div class="bz-fond__tranche"></div>
		<div class="bz-fond__tranche bz-fond__tranche--retournee"></div>
		<div class="bz-fond__tranche"></div>
		<div class="bz-fond__tranche bz-fond__tranche--retournee bz-fond__tranche--fin"></div>
	</div>
{% endblock %}

{% block body %}
	<main class="bz-principal">
		<section class="bz-heros bz-legal__heros">
			<div class="bz-conteneur">
				<h1 class="bz-heros__accroche">
					<span class="bz-heros__accroche-ligne">{% block legal_title %}{% endblock %}</span>
					<span class="bz-heros__accroche-ligne bz-heros__accroche-ligne--forte">{% block legal_title_fort %}{% endblock %}</span>
				</h1>
				<p class="bz-legal__date">Dernière mise à jour&nbsp;: novembre 2026</p>
				{% block legal_intro %}{% endblock %}
			</div>
		</section>

		<div class="bz-conteneur bz-legal">
			{% block legal_content %}{% endblock %}
		</div>
	</main>
{% endblock %}
